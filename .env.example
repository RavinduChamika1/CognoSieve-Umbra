# ==============================================================================
# CognoSieve Umbra - Centralized Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your environment variables:
#   cp .env.example .env
#
# DO NOT commit production secrets or API keys to version control.
# ==============================================================================

# [Optional] Google Gemini API Key for executive defensive AI narrative summaries
# Set here or via standard system environment variable: GEMINI_API_KEY
GEMINI_API_KEY=

# [Optional] CognoSievePromptinj Bridge Base URL (if automated API launching is enabled)
PROMPTINJ_API_BASE_URL=http://127.0.0.1:8080/api/v1

# [Optional] Database path override (defaults to umbra.db)
# UMBRA_DB_PATH=umbra.db
